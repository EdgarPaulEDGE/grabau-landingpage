# --- Lead-Versand per E-Mail (optional, aber empfohlen fuer Produktion) ---
# Ohne diese Werte funktioniert das Formular trotzdem: Leads werden lokal
# in data/leads.jsonl gespeichert und der Nutzer bekommt einen mailto-Fallback.

# API-Key von https://resend.com (kostenloser Plan reicht fuer den Start)
RESEND_API_KEY=

# Absender-Adresse (muss bei Resend als verifizierte Domain hinterlegt sein)
LEAD_FROM_EMAIL=grabau@wfl.de

# Wohin die Lead-Benachrichtigung geht (Nina + optional EDGE in CC)
LEAD_TO_EMAIL=warncke@wfl.de
LEAD_CC_EMAIL=
